# Sao chep file nay thanh ".env" trong cung thu muc, dien gia tri that vao,
# KHONG commit file ".env" (da co trong .gitignore).

# Lay tu @BotFather tren Telegram (xem README muc "Lay Telegram token")
TELEGRAM_BOT_TOKEN=

# Chat ID cua ban (hoac cua group) — xem README muc "Lay chat_id"
TELEGRAM_CHAT_ID=
